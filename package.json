{
  "name": "OpenStreetMap Tool",
  "version": "0.5.0",
  "description": "Tools for helping to improve OpenStreetMap.",
  "private": false,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "contributors": [
    "UKChris-osm",
    "haignet.co.uk"
  ],
  "devDependencies": {
    "@types/bun": "1.4.4"
  },
  "engines": {
    "bun": "1.4.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/UKChris-osm/openstreetmaptools.git"
  },
  "scripts": {
    "check": "bun run --parallel check:*",
    "check:lint": "bun lint",
    "check:types": "bun check",
    "osm:nsi": "bun run NSI/fetch-nsi-logos.ts",
    "osm:postoffice": "bun run postoffice/get-post-office-data.ts",
    "osm:overpass-download": "bun run scripts/test-overpass-download.ts"
  }
}
